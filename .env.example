# Unified workspace PostgreSQL profile (ENVIRONMENT_SPEC section 7.1).
# Canonical full profile: see .env.postgres.example
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

MINIO_ROOT_USER=sdkworkfs
MINIO_ROOT_PASSWORD=sdkworkfs123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SDKWORK_FS_S3_BUCKET=sdkworkfs
SDKWORK_FS_S3_REGION=ap-east-1
SDKWORK_FS_S3_PRESIGN_EXPIRY_SECONDS=900
SDKWORK_FS_S3_AUTO_CREATE_BUCKET=true
SDKWORK_FS_S3_FAIL_FAST_ON_MISSING_BUCKET=true
SDKWORK_FS_GIT_MANAGED_ROOT_DIR=/var/lib/sdkworkfs/git/repos
SDKWORK_FS_BUILD_WORKSPACE_ROOT_DIR=/var/lib/sdkworkfs/build/workspaces
SDKWORK_FS_BUILD_COMMAND_PATH_PREPEND=
SDKWORK_FS_BUILD_NODE_ENABLED=false
SDKWORK_FS_BUILD_NODE_INSTALL_TIMEOUT_SECONDS=300
SDKWORK_FS_BUILD_NODE_BUILD_TIMEOUT_SECONDS=300
SDKWORK_FS_BUILD_JAVA_ENABLED=false
SDKWORK_FS_BUILD_JAVA_MAVEN_TIMEOUT_SECONDS=600
SDKWORK_FS_BUILD_JAVA_GRADLE_TIMEOUT_SECONDS=600
SDKWORK_FS_BUILD_PYTHON_ENABLED=false
SDKWORK_FS_BUILD_PYTHON_BUILD_TIMEOUT_SECONDS=600
SDKWORK_FS_CACHE_OBJECT_ROOT_DIR=/var/lib/sdkworkfs/cache/objects
SDKWORK_FS_CACHE_MATERIALIZED_ROOT_DIR=/var/lib/sdkworkfs/materialized
SDKWORK_FS_NODE_METADATA_ROOT_DIR=/var/lib/sdkworkfs/node/metadata

NATS_PORT=4222
NATS_MONITOR_PORT=8222

APP_PORT=18080
